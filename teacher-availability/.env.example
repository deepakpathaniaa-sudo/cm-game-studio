# Set these in Vercel → Project → Settings → Environment Variables
# (and locally in a .env / your shell if you want to test against Supabase).
# When BOTH are set, the app uses Supabase Postgres. When unset, it falls back
# to a local JSON file (data/db.json) — handy for local dev, but NOT for Vercel.

SUPABASE_URL=https://cqzpzhdleqyrmedymypg.supabase.co

# The project's SECRET (service_role) key. Get it from:
#   Supabase Dashboard → Project "cm-whiteboard" → Settings → API →
#   "service_role" secret  (or the new "secret" key under API Keys).
# Server-side ONLY. Never expose this in the browser or commit it.
SUPABASE_SECRET_KEY=your-service-role-secret-key
